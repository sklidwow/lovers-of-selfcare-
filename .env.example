# YClients API access
# Partner token: YClients marketplace / dev panel -> your application -> API key
YCLIENTS_PARTNER_TOKEN=

# User token: needed for endpoints that read bookings/clients/finance
# (get it via POST /auth with a salon login+password, or from YClients support)
YCLIENTS_USER_TOKEN=

# Company (filial) id to query, from the YClients admin panel URL
YCLIENTS_COMPANY_ID=

# Shared secret required in the X-Api-Key header on every /api/yclients/* call
DASHBOARD_API_KEY=

# Optional: browser origin allowed to call these endpoints via CORS
# (leave empty if the dashboard only calls the API server-side)
DASHBOARD_ALLOWED_ORIGIN=
